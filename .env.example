PORT=3000

# Local development (docker compose): separate variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=kosku
DB_PASSWORD=kosku_dev_password
DB_NAME=kosku
DB_SYNCHRONIZE=true

# Hosted database (production): a single connection string. When set, it replaces DB_* above.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Production only: allowed frontend URL(s), comma-separated, no trailing slash
# CORS_ORIGINS=https://your-frontend.pages.dev

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

PORT=3000

# Local development (docker compose): separate variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=kosku
DB_PASSWORD=kosku_dev_password
DB_NAME=kosku
# Set to true on the first local run so the tables get created, then set it back to false
DB_SYNCHRONIZE=false

# Hosted database (production): a single connection string. When set, it replaces DB_* above.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Production only: allowed frontend URL(s), comma-separated, no trailing slash
# CORS_ORIGINS=https://your-frontend.example.com

# Required. Generate a random value with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Needed to create the first admin (sent in the X-Register-Key header).
# Without it, POST /auth/register is disabled. Use a different random value than JWT_SECRET.
# REGISTER_KEY=